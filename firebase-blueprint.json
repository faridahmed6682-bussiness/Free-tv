{
  "entities": {
    "UserConfig": {
      "title": "UserConfig",
      "description": "User specific IPTV config like M3U URL or Xtream Codes.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The ID of the user."
        },
        "configType": {
          "type": "string",
          "enum": ["m3u", "xtream"],
          "description": "Type of the configured IPTV."
        },
        "url": {
          "type": "string",
          "description": "The URL for M3U or Xtream."
        },
        "username": {
          "type": "string",
          "description": "Optional username for Xtream."
        },
        "password": {
          "type": "string",
          "description": "Optional password for Xtream."
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp of the last update."
        }
      },
      "required": ["userId", "configType", "url", "updatedAt"]
    },
    "Sponsor": {
      "title": "Sponsor",
      "description": "Sponsor banner advertisements that marquee on screen.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Sponsor ID."
        },
        "imageUrl": {
          "type": "string",
          "description": "Image URL of the sponsor logo/banner."
        },
        "text": {
          "type": "string",
          "description": "Sponsor display text or slogan."
        },
        "linkUrl": {
          "type": "string",
          "description": "Target destination URL when clicked."
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether this sponsor is actively shown in the marquee."
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp of the last update."
        }
      },
      "required": ["id", "imageUrl", "text", "updatedAt"]
    }
  },
  "firestore": {
    "userConfigs/{userId}": {
      "schema": "UserConfig",
      "description": "User configurations."
    },
    "sponsors/{sponsorId}": {
      "schema": "Sponsor",
      "description": "Sponsor banner advertisements."
    }
  }
}
